{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": ".",
  "buildCommand": "npm run build",
  "git": {"deploymentEnabled": {"market-data": false}},
  "headers": [{"source":"/(.*)","headers":[{"key":"Referrer-Policy","value":"no-referrer"},{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"X-Frame-Options","value":"DENY"},{"key":"Content-Security-Policy","value":"default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' https://*.supabase.co; img-src 'self' data:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"}]}],
  "functions": {
    "api/data-status.py": {
      "maxDuration": 15
    },
    "api/market-data.py": {
      "maxDuration": 60
    },
    "api/search-symbols.py": {
      "maxDuration": 15
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/demo/index.html" },
    { "source": "/portfolio", "destination": "/demo/index.html" },
    { "source": "/analysis", "destination": "/demo/index.html" },
    { "source": "/optimize", "destination": "/demo/index.html" },
    { "source": "/simulation", "destination": "/demo/index.html" },
    { "source": "/method", "destination": "/demo/index.html" },
    { "source": "/account", "destination": "/demo/index.html" },
    { "source": "/demo", "destination": "/demo/index.html" },
    { "source": "/demo/", "destination": "/demo/index.html" }
  ]
}
